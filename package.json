{
  "name": "demirkale-kingdom-simulation",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --import tsx --test tests/game-rules.test.ts tests/password-auth.test.ts tests/byok-crypto.test.ts tests/world-projection.test.ts tests/general-action-fallback.test.ts tests/save-validation.test.ts tests/general-guard.test.ts tests/general-proposal.test.ts tests/general-world-actions.test.ts tests/general-risk.test.ts tests/general-review.test.ts tests/engine.test.ts tests/night-shift.test.ts tests/world-map.test.ts tests/populace.test.ts tests/populace-voice.test.ts tests/faction.test.ts tests/raids.test.ts tests/river.test.ts tests/storage.test.ts tests/market.test.ts tests/general-name.test.ts tests/ledger.test.ts tests/general-requests.test.ts tests/policy.test.ts tests/negotiation.test.ts tests/negotiation-brief.test.ts",
    "test:site": "npm run build && node --test tests/rendered-html.test.mjs",
    "api": "tsx watch server/index.ts",
    "api:start": "tsx server/index.ts",
    "tick": "tsx server/tick/worker.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate-from-d1": "tsx scripts/migrate-d1-to-postgres.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "drizzle-orm": "0.45.2",
    "fastify": "^5.6.2",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.179.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.179.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

# docker compose için. Uygulama sırları .dev.vars dosyasındadır (miniflare onu okur).

# CRON_SECRET burada ve .dev.vars içinde AYNI olmalı; cron sidecar'ı bu sırla doğrulanır.
CRON_SECRET=demirkale-local-cron-secret

# Gece vardiyasının tetikleneceği adres. Yayındaki sürümü tetiklemek için
# https://<siteniz>/api/cron yazın; o zaman `app` servisine gerek kalmaz.
CRON_TARGET=http://app:3000/api/cron

# Uyanma aralığı. Sunucu zaten saatte birden sık iş yapmaz.
CRON_INTERVAL_SECONDS=3600

# --- Veritabanı ---
# Uygulama Postgres kullanır. Bağlantı dizesi .dev.vars içindeki DATABASE_URL'dir:
#   konteyner içinden : postgres://demirkale:demirkale@postgres:5432/demirkale
#   host'tan          : postgres://demirkale:demirkale@127.0.0.1:5433/demirkale
# Yayında Worker secret olarak DATABASE_URL girilmeli ve Postgres dışarıdan
# erişilebilir olmalı (sslmode=require). Ölçekte önüne Hyperdrive/PgBouncer konmalı.

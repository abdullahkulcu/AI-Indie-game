# Krallık Simülasyonu — ortam değişkenleri
#
# Geliştirmede bu dosyayı `.env` olarak kopyalayın. Üretimde JWT_SECRET ve
# MASTER_KEY zorunludur; varsayılan değerlerle başlatma reddedilir.

# --- Altyapı ---------------------------------------------------------------
DATABASE_URL=postgres://krallik:krallik@localhost:5432/krallik
REDIS_URL=redis://localhost:6379

PORT=8080
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# --- Sırlar ----------------------------------------------------------------
# Oturum imzalama anahtarı.
JWT_SECRET=degistir-bunu-uzun-ve-rastgele-bir-degerle
JWT_EXPIRES_IN=30d

# Envelope encryption kök anahtarı (KEK). Oyuncuların BYOK API anahtarlarını
# saran anahtar budur (§14.6, §15.5) — 32 baytlık base64 bir değer olmalı.
# Üretmek için:  openssl rand -base64 32
# Üretimde bir KMS'ten gelmeli; sızarsa tüm oyuncu anahtarları risk altına girer.
MASTER_KEY=BwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwcHBwc=

# --- Tick servisi ----------------------------------------------------------
TICK_INTERVAL_SECONDS=60
TICK_BATCH_SIZE=200
# Pasif mod LLM çağrılarının eşzamanlılığı — oyuncu anahtarları rate-limit
# yemesin diye düşük tutuluyor.
PASSIVE_LLM_CONCURRENCY=4

# --- LLM katmanı -----------------------------------------------------------
# NOT: Burada hiçbir sağlayıcı anahtarı YOKTUR ve olmamalıdır. Platform kendi
# LLM faturasını ödemiyor; her oyuncu kendi anahtarını arayüzden giriyor ve
# anahtar şifreli olarak veritabanında saklanıyor (§15.4).
LLM_TIMEOUT_MS=60000
LLM_MAX_TOOL_ROUNDS=6

# --- Frontend --------------------------------------------------------------
VITE_API_URL=http://localhost:8080

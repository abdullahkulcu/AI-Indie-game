# docker compose için. Uygulama sırları .dev.vars dosyasındadır (miniflare onu okur).
# CRON_SECRET burada ve .dev.vars içinde AYNI olmalı; cron sidecar'ı bu sırla doğrulanır.
CRON_SECRET=demirkale-local-cron-secret

# Gece vardiyasının tetikleneceği adres. Yayındaki sürümü tetiklemek için
# https://<siteniz>/api/cron yazın; o zaman `app` servisine gerek kalmaz.
CRON_TARGET=http://app:3000/api/cron

# Uyanma aralığı. Sunucu zaten saatte birden sık iş yapmaz; bu değeri
# düşürmek yalnızca kaçırılan saatlerin daha çabuk telafi edilmesini sağlar.
CRON_INTERVAL_SECONDS=3600
